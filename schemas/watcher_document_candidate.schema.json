{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/schemas/watcher_document_candidate.schema.json",
  "title": "Lumen Watcher Document Candidate v2",
  "description": "S11.0 metadata-only candidate contract. Path and filename are hints, never canonical fiscal classification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event", "file", "path_context", "technical_probe"],
  "properties": {
    "contract_version": { "const": 2 },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "detected_at"],
      "properties": {
        "event_type": { "const": "FILE_STABLE" },
        "detected_at": { "type": "string", "format": "date-time" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "file_name", "extension", "size", "mtime_ns", "sha256"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?![A-Za-z]:)(?![\\\\/]).+" },
        "file_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "extension": { "enum": [".pdf", ".json", ".xml", ".zip"] },
        "size": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "path_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterprise_folder_candidate", "fiscal_root", "segments_below_fiscal_root", "period_candidates", "period_ambiguous", "classifier_hint"],
      "properties": {
        "enterprise_folder_candidate": { "type": "string", "minLength": 1, "maxLength": 255 },
        "fiscal_root": { "const": "Escrita Fiscal" },
        "segments_below_fiscal_root": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
        "period_candidates": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" } },
        "period_ambiguous": { "type": "boolean" },
        "classifier_hint": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "technical_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "valid"],
      "properties": {
        "format": { "enum": ["PDF", "JSON", "XML", "ZIP"] },
        "valid": { "type": "boolean" }
      }
    }
  }
}
