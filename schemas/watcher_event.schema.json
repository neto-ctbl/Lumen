{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/schemas/watcher_event.schema.json",
  "title": "Lumen Watcher Fiscal Event",
  "description": "S10.0 contract only. Traversal, root and reparse-point validation are semantic checks for S10.1/S10.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "relative_path",
    "file_name",
    "file_sha256",
    "file_size",
    "detected_at",
    "folder_period",
    "folder_company",
    "classifier_hint",
    "pdf_probe"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "event_type": { "const": "FILE_STABLE" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/]).+"
    },
    "file_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "file_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "file_size": { "type": "integer", "minimum": 0 },
    "detected_at": { "type": "string", "format": "date-time" },
    "folder_period": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "folder_company": { "type": "string", "minLength": 1, "maxLength": 255 },
    "classifier_hint": { "type": "string", "minLength": 1, "maxLength": 100 },
    "pdf_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_pdf", "page_count", "has_extractable_text", "text_length"],
      "properties": {
        "is_pdf": { "type": "boolean" },
        "page_count": { "type": "integer", "minimum": 0 },
        "has_extractable_text": { "type": "boolean" },
        "text_length": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
