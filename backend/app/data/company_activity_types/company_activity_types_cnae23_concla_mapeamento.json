  "company_post_processing": {
    "description": "Regras determinísticas de consolidação dos activity_type no nível da empresa, aplicadas depois que cada CNAE ativo já foi classificado individualmente via classification_contract + rules. Esta etapa nunca reclassifica um CNAE; ela apenas decide quais activity_type sobrevivem no conjunto final da empresa.",
    "applies_after": "classification_contract + rules (aplicados CNAE a CNAE)",
    "input": "União (set, sem duplicatas) dos activity_type resultantes de todos os CNAEs ativos da empresa.",
    "specific_classes": [
      "TEMPLO_RELIGIOSO",
      "SERVICOS_MEDICOS_ODONTOLOGICOS",
      "SERVICOS_IMOBILIARIOS"
    ],
    "generic_classes": [
      "SERVICOS"
    ],
    "neutral_classes_always_kept": [
      "COMERCIO",
      "INDUSTRIA"
    ],
    "steps": [
      {
        "step": 1,
        "step_id": "UNIAO_INICIAL",
        "description": "A empresa recebe inicialmente a união de todos os activity_type inferidos a partir de cada um dos seus CNAEs ativos, sem nenhuma supressão nesta etapa."
      },
      {
        "step": 2,
        "step_id": "SUPRESSAO_SERVICOS_GENERICO",
        "description": "SERVICOS é a categoria residual/genérica do contrato (fallback de priority 90). Se o conjunto da empresa contiver SERVICOS junto de qualquer uma das specific_classes, SERVICOS é removido do conjunto final: a presença de uma classificação mais específica torna o rótulo genérico redundante para fins de segmentação de empresa.",
        "suppresses_generic_services_when_coexists_with": [
          "TEMPLO_RELIGIOSO",
          "SERVICOS_MEDICOS_ODONTOLOGICOS",
          "SERVICOS_IMOBILIARIOS"
        ],
        "note_comercio_industria": "COMERCIO e INDUSTRIA nunca disparam nem sofrem essa supressão: convivem livremente entre si, com SERVICOS e com qualquer specific_class, pois representam naturezas econômicas primárias e não um rótulo genérico."
      },
      {
        "step": 3,
        "step_id": "SEM_ANULACAO_CRUZADA_ENTRE_CLASSES_ESPECIFICAS",
        "description": "TEMPLO_RELIGIOSO, SERVICOS_MEDICOS_ODONTOLOGICOS e SERVICOS_IMOBILIARIOS não se anulam automaticamente entre si, nem eliminam COMERCIO ou INDUSTRIA. Qualquer supressão adicional entre duas ou mais specific_classes exigiria uma regra formal, versionada e justificada nesta mesma seção; nenhuma existe nesta versão do contrato."
      }
    ],
    "algorithm_pseudocode": "final_set = union(activity_type for cnae in active_cnaes)\nif final_set & {TEMPLO_RELIGIOSO, SERVICOS_MEDICOS_ODONTOLOGICOS, SERVICOS_IMOBILIARIOS}:\n    final_set.discard('SERVICOS')\nreturn sorted(final_set)",
    "determinism_guarantees": {
      "deterministic": true,
      "auditable": true,
      "idempotent": true,
      "idempotency_note": "Reaplicar a consolidação sobre um conjunto já consolidado produz o mesmo conjunto: a regra de supressão depende apenas da composição do set (operação de conjunto, sem estado externo e sem dependência de ordem de avaliação dos CNAEs)."
    },
    "examples": [
      {
        "input": [
          "SERVICOS",
          "SERVICOS_MEDICOS_ODONTOLOGICOS"
        ],
        "output": [
          "SERVICOS_MEDICOS_ODONTOLOGICOS"
        ],
        "explanation": "SERVICOS é suprimido por coexistir com uma classe específica (SERVICOS_MEDICOS_ODONTOLOGICOS)."
      },
      {
        "input": [
          "COMERCIO",
          "SERVICOS_MEDICOS_ODONTOLOGICOS"
        ],
        "output": [
          "COMERCIO",
          "SERVICOS_MEDICOS_ODONTOLOGICOS"
        ],
        "explanation": "Não havia SERVICOS no conjunto; COMERCIO nunca é suprimido, então o conjunto permanece igual."
      },
      {
        "input": [
          "INDUSTRIA",
          "SERVICOS_IMOBILIARIOS",
          "SERVICOS"
        ],
        "output": [
          "INDUSTRIA",
          "SERVICOS_IMOBILIARIOS"
        ],
        "explanation": "SERVICOS é suprimido por coexistir com SERVICOS_IMOBILIARIOS; INDUSTRIA é preservado por ser classe neutra."
      },
      {
        "input": [
          "COMERCIO",
          "INDUSTRIA",
          "SERVICOS"
        ],
        "output": [
          "COMERCIO",
          "INDUSTRIA",
          "SERVICOS"
        ],
        "explanation": "Nenhuma specific_class presente no conjunto; a condição de supressão não é satisfeita, então SERVICOS permanece."
      }
    ]
  },
