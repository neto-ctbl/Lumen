APP_NAME=Lumen
APP_ENV=local
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen
DATABASE_URL=postgresql+psycopg://lumen:lumen@localhost:5435/lumen

REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_URL=redis://localhost:6382/0

VITE_API_BASE_URL=http://localhost:8000
VITE_LUMEN_API_BASE_URL=http://localhost:8000
VITE_LUMEN_FRONTEND_PORT=5175

LUMEN_TEST_DATABASE_URL=postgresql+psycopg://lumen:lumen@localhost:5435/lumen_test

SECRET_KEY=change-me-only-local
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
LOG_JSON=true

INITIAL_ADMIN_EMAIL=admin@example.local
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Initial Admin
INITIAL_ORG_NAME=Neto Contabilidade
INITIAL_ORG_SLUG=neto-contabilidade

ECONTROLE_API_BASE_URL=http://localhost:8020/api/v1
ECONTROLE_API_TOKEN=
ECONTROLE_WEBHOOK_TOKEN=
ECONTROLE_TIMEOUT_SECONDS=15

ACESSORIAS_API_BASE_URL=https://api.acessorias.com
ACESSORIAS_API_TOKEN=
ACESSORIAS_TIMEOUT_SECONDS=15
ACESSORIAS_REQUESTS_PER_MINUTE=100

SITTAX_AUTH_BASE_URL=https://autenticacao.sittax.com.br
SITTAX_API_BASE_URL=https://api.sittax.com.br
SITTAX_APURACAO_BASE_URL=https://apuracao.sittax.com.br
SITTAX_EMAIL=
SITTAX_PASSWORD=
SITTAX_API_TOKEN=
SITTAX_TIMEOUT_SECONDS=20

ECONET_BASE_URL=https://www.econeteditora.com.br
ECONET_TIMEOUT_SECONDS=20
ECONET_ASSISTED_SESSION_ENABLED=false
ECONET_SESSION_MAX_AGE_MINUTES=480
ECONET_ENRICH_DEFAULT_LIMIT=5
ECONET_ENRICH_MAX_LIMIT=50
ECONET_ENRICH_REQUEST_DELAY_SECONDS=0.5
# Fiscal watcher agent (local process only; the org slug remains server-side)
LUMEN_WATCHER_ROOT=G:\EMPRESAS
LUMEN_WATCHER_API_BASE_URL=http://localhost:8000
LUMEN_WATCHER_AGENT_TOKEN=
LUMEN_WATCHER_SCAN_INTERVAL_SECONDS=15
LUMEN_WATCHER_STABLE_SECONDS=5
LUMEN_WATCHER_HTTP_TIMEOUT_SECONDS=15
LUMEN_WATCHER_STATE_PATH=agent/.state/watcher_state.json
LUMEN_WATCHER_HEALTH_PATH=agent/.state/watcher_health.json

# Watcher backend/server only. The local agent must not receive this value.
LUMEN_WATCHER_AGENT_ORG_SLUG=
